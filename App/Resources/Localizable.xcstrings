    "A damaged or incompatible local autosave was found (%@). It was set aside, and VideoNotes opened a new workspace; no source media was changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine beschädigte oder inkompatible lokale automatische Sicherung wurde gefunden (%@). Sie wurde beiseitegelegt, und VideoNotes hat einen neuen Arbeitsbereich geöffnet; die Quellmedien wurden nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A damaged or incompatible local autosave was found (%@). It was set aside, and VideoNotes opened a new workspace; no source media was changed."
          }
        }
      }
    },
    "its recovery data could not be read": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Wiederherstellungsdaten konnten nicht gelesen werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "its recovery data could not be read"
          }
        }
      }
    },
    "The private recovery key is unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der private Wiederherstellungsschlüssel ist nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private recovery key is unavailable."
          }
        }
      }
    },
    "%@ The encrypted autosave was kept safely in place so VideoNotes can try again later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die verschlüsselte automatische Sicherung wurde sicher beibehalten, damit VideoNotes es später erneut versuchen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ The encrypted autosave was kept safely in place so VideoNotes can try again later."
          }
        }
      }
    },
    "The workspace recovery files were removed, but their private Keychain encryption key could not be retired. No recovery data was recreated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiederherstellungsdateien des Arbeitsbereichs wurden entfernt, aber ihr privater Schlüsselbund-Verschlüsselungsschlüssel konnte nicht außer Betrieb genommen werden. Es wurden keine Wiederherstellungsdaten neu erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The workspace recovery files were removed, but their private Keychain encryption key could not be retired. No recovery data was recreated."
          }
        }
      }
    },
