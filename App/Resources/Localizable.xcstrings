    "Source-provided definitions lead as cues, complete notes follow in source order, and summaries close the set.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Quellenbasierte Definitionen stehen als Stichwörter vorn, vollständige Notizen folgen in Quellenreihenfolge und Zusammenfassungen bilden den Abschluss."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Source-provided definitions lead as cues, complete notes follow in source order, and summaries close the set."
          }
        }
      }
    },
    "Groups complete source sections by semantic level—concepts, definitions, methods, processes, comparisons, quotes, then review.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppiert vollständige Quellenabschnitte nach Bedeutungsebene: Konzepte, Definitionen, Methoden, Prozesse, Vergleiche, Zitate und anschließend Wiederholung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Groups complete source sections by semantic level—concepts, definitions, methods, processes, comparisons, quotes, then review."
          }
        }
      }
    },
    "Orders dated source sections chronologically, safely pairing short adjacent moments; undated review material stays last.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnet datierte Quellenabschnitte chronologisch und kombiniert kurze benachbarte Momente sicher; undatiertes Wiederholungsmaterial bleibt am Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Orders dated source sections chronologically, safely pairing short adjacent moments; undated review material stays last."
          }
        }
      }
    },
    "Prioritizes source-provided definitions and topic headings as study-card prompts; it never generates questions, and remaining material stays as reference cards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorisiert quellenbasierte Definitionen und Themenüberschriften als einzelne Lernkartenimpulse; es werden keine Fragen erzeugt, übriges Material bleibt als Referenzkarten erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritizes source-provided definitions and topic headings as study-card prompts; it never generates questions, and remaining material stays as reference cards."
          }
        }
      }
    },
    "Puts summaries, definitions and comparisons first, then safely pairs shorter source material for rapid revision.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Zusammenfassungen, Definitionen und Vergleiche voran und kombiniert anschließend kürzeres Quellenmaterial sicher für eine schnelle Wiederholung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Puts summaries, definitions and comparisons first, then safely pairs shorter source material for rapid revision."
          }
        }
      }
    },
    "Leads with source-provided processes and methods, then retains every remaining section as ordered reference material.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beginnt mit quellenbasierten Prozessen und Methoden und behält anschließend jeden übrigen Abschnitt als geordnetes Referenzmaterial bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leads with source-provided processes and methods, then retains every remaining section as ordered reference material."
          }
        }
      }
    },
    "Surfaces source-provided comparisons, processes and methods first; it never invents decisions or tasks, and retains everything else as reference.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hebt quellenbasierte Vergleiche, Prozesse und Methoden hervor; Entscheidungen oder Aufgaben werden nie erfunden, alles Weitere bleibt als Referenz erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Surfaces source-provided comparisons, processes and methods first; it never invents decisions or tasks, and retains everything else as reference."
          }
        }
      }
    },
